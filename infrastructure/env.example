# Core (development defaults)
NODE_ENV=development
APP_PORT=3000
API_PORT=4000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Production notes:
# - set NODE_ENV=production
# - set CORS_ORIGINS to real frontend origin(s) only, for example:
#   CORS_ORIGINS=https://interfaith.billthomson.elementfx.com
# - keep frontend runtime apiFallback empty unless you intentionally enable an emergency fallback
# - leave ALLOW_DEV_STUB_AUTH unset/false in production

# Auth
SESSION_SECRET=change-me
ALLOW_DEV_STUB_AUTH=false
ADMIN_USER_IDS=demo-admin,ops
QUEUE_TTL_MS=300000

# Database
DATABASE_URL=postgresql://interfaith:interfaith@localhost:5432/interfaith
USE_POSTGRES=false

# Redis
REDIS_URL=redis://localhost:6379

# Realtime / WebRTC
TURN_URL=turn:localhost:3478
TURN_USERNAME=demo
TURN_PASSWORD=demo
